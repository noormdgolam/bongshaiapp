<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="The premier B2B marketplace for construction materials, steel products, PEB components, and building supplies in Bangladesh.">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/index.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <h1 class="hero-title">The Premier B2B Marketplace<br>for Global Sourcing</h1>
      <p class="hero-subtitle">Source products and materials directly from verified manufacturers worldwide across 16 major industries. Streamline your procurement with RFQs, transparent pricing, and secure escrow.</p>
      <div class="hero-actions">
        <a href="/rfq" class="btn-primary">Post an RFQ</a>
        <a href="/suppliers" class="btn-secondary">Browse Suppliers</a>
      </div>
    </div>
  </section>

  <!-- Trust Badges Section -->
  <section class="trust-section">
    <div class="container">
      <h2 class="trust-title">Why Source on Bongshai?</h2>
      <div class="trust-grid">
        <div class="trust-card glass-panel">
          <div class="trust-icon verified">✓</div>
          <h3>Bongshai Verified</h3>
          <p>Every supplier undergoes a rigorous business verification process to ensure credibility.</p>
        </div>
        <div class="trust-card glass-panel">
          <div class="trust-icon audited">👁</div>
          <h3>Site-Audited</h3>
          <p>Premium suppliers have their manufacturing facilities physically audited by our team.</p>
        </div>
        <div class="trust-card glass-panel">
          <div class="trust-icon compliant">★</div>
          <h3>BSTI Compliant</h3>
          <p>Products meet strict local standards, with mill certs and EPDs available for download in the Document Vault.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="categories-section container">
    <div class="section-header">
      <h2 class="section-title">Explore Categories</h2>
      <a href="/categories" class="btn-secondary">View All</a>
    </div>
    <div class="categories-grid">
      <!-- Construction (Flagship) -->
      <div class="category-card flagship">
        <div class="category-content">
          <h3>Construction & Building Materials</h3>
          <p>Steel, Cement, PEB, Roofing & Pipes.</p>
          <a href="#" class="category-link">Source Now</a>
        </div>
      </div>
      
      <!-- Apparel -->
      <div class="category-card flagship">
        <div class="category-content">
          <h3>Apparel, Textiles & Fashion</h3>
          <p>Garments, Fabrics, Leather & Footwear.</p>
          <a href="#" class="category-link">Source Now</a>
        </div>
      </div>

      <!-- Industrial Machinery -->
      <div class="category-card">
        <div class="category-content">
          <h3>Industrial Machinery</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>
      
      <div class="category-card">
        <div class="category-content">
          <h3>Electronics & Electrical</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>
      
      <div class="category-card">
        <div class="category-content">
          <h3>Home & Furniture</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Health & Beauty</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Agriculture & Food</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Chemicals & Raw Materials</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Packaging & Printing</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Automotive & Transport</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Metals & Mining</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Office & Education</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Sports & Leisure</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Energy & Environment</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Gifts & Crafts</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>

      <div class="category-card">
        <div class="category-content">
          <h3>Business Services</h3>
          <a href="#" class="category-link">Explore</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/public/js/main.js"></script>
</body>
</html>
